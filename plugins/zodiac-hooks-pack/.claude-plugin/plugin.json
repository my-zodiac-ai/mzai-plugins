{
  "name": "zodiac-hooks-pack",
  "version": "0.1.0",
  "description": "Reusable Claude Code hooks for the My Zodiac AI ecosystem (my_zodiac_ai, companion-ai, astro-ai-landing). Self-detecting, fail-soft, individually disable-able. Covers sensitive-file blocking, ESLint --fix, TypeScript checks, Prisma migration reminders, GSAP import guards, @nuxt/content frontmatter validation, Serena session reminders, and i18n hardcoded-string warnings.",
  "author": {
    "name": "Valentyn Yakovliev"
  },
  "keywords": [
    "hooks",
    "safety",
    "eslint",
    "typescript",
    "prisma",
    "gsap",
    "nuxt-content",
    "serena",
    "i18n",
    "my-zodiac-ai"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/serena-session-reminder.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/block-sensitive-files.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/prisma-migration-reminder.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/gsap-import-guard.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/i18n-key-checker.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/eslint-on-save.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/tsc-after-edit.sh\""
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/frontmatter-validator.py\""
          }
        ]
      }
    ]
  }
}
